# Copy to ".env" (same folder as docker-compose.yml) and fill in.
# Docker Compose auto-loads .env. Do NOT commit the real .env.
# All values are optional — docker-compose.yml has safe localhost defaults.

# ── URLs ──────────────────────────────────────────────────────────────────────
# CLIENT_URL          = frontend origin allowed for CORS / Socket.io
# NEXT_PUBLIC_API_URL = URL the browser uses to call the API (baked into the
#                       Next.js build). Point at the gateway (port 8080).
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── App secrets ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-long-random-string

# ── Cleanup worker ────────────────────────────────────────────────────────────
# How often the worker sweeps for stale bookings / expired lobbies (minutes).
CLEANUP_INTERVAL_MIN=30

# ── Payment providers (booking service) ───────────────────────────────────────
# Only set the providers you actually use; others can stay empty.

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ZaloPay
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
